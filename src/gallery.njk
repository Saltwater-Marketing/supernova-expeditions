---
layout: base.njk
permalink: /gallery/
title: "Photo Gallery | Supernova Expeditions"
description: "Photos from Supernova Expeditions: the yacht, staterooms, landing craft, island hikes, paddling, diving & Northwest meals in the San Juan Islands."
hero:
  image: "swimming-rocks.webp"
  alt: "Guests swimming off granite rocks in a clear lake"
  h1: "Photo Gallery: Life Aboard Supernova"
  jump: {"label": "See the Photos", "href": "#photos"}
  sub: "Scenes from the San Juan Islands, the Gulf Islands and life aboard Supernova."
---
{% from "macros.njk" import book %}
{% include "hero.njk" %}
<section id="photos" style="padding-top:56px;scroll-margin-top:100px">
  <div class="wrap">
    <ul class="jump-links">
      {% for g in gallery %}<li><a href="#{{ g.id }}">{{ g.title }} <small>({{ g.photos.length }})</small></a></li>{% endfor %}
    </ul>
    {% for g in gallery %}
    <div class="g-section" id="{{ g.id }}">
      <h2>{{ g.title }} <small>{{ g.photos.length }} photo{{ "s" if g.photos.length != 1 }}</small></h2>
      <div class="g-grid">
        {% for ph in g.photos %}<button type="button" data-full="/images/w/{{ ph[0] | replace('.webp','') }}-{{ imgmeta[ph[0]].widths | last }}.webp" data-caption="{{ ph[1] }}" aria-label="Enlarge: {{ ph[1] }}">{% img ph[0], ph[1], "(max-width:760px) 50vw, 380px" %}</button>{% endfor %}
      </div>
      <p><a class="text-link" href="{{ g.link }}">{{ g.linkText }}</a></p>
    </div>
    {% endfor %}
  </div>
</section>
<div class="lightbox" id="lightbox" hidden role="dialog" aria-modal="true" aria-label="Photo viewer">
  <button class="lb-close" type="button" aria-label="Close">&times;</button>
  <button class="lb-prev" type="button" aria-label="Previous photo">‹</button>
  <button class="lb-next" type="button" aria-label="Next photo">›</button>
  <figure style="margin:0"><img alt="" id="lb-img"><p id="lb-cap"></p></figure>
</div>
{% include "cta.njk" %}
