{#- Banner: tall clean photo (no text on it), then a white band with the H1 and at most one jump button. Set in front matter:
    hero: { image, alt, h1, jump: {label, href}, kicker, sub, pos } -#}
<section class="hero" style="padding:0">
  <div class="hero-media">
    <img src="/images/w/{{ hero.image | replace('.webp','') }}-{{ imgmeta[hero.image].widths[1] or imgmeta[hero.image].widths[0] }}.webp" srcset="{{ hero.image | heroSrcset }}" sizes="100vw" alt="{{ hero.alt }}" width="{{ imgmeta[hero.image].w }}" height="{{ imgmeta[hero.image].h }}" fetchpriority="high"{% if hero.pos %} style="object-position:{{ hero.pos }}"{% endif %}>
  </div>
  <div class="wrap hero-band">
    <h1>{{ hero.h1 | safe }}</h1>
    {%- if hero.jump %}<a class="btn btn-jump" href="{{ hero.jump.href }}">{{ hero.jump.label }}</a>{% endif %}
  </div>
</section>
{%- if hero.kicker or hero.sub %}
<section class="hero-follow">
  <div class="wrap">
    {% if hero.kicker %}<p class="kicker">{{ hero.kicker | safe }}</p>{% endif %}
    {% if hero.sub %}<p class="hero-sub">{{ hero.sub | safe }}</p>{% endif %}
    <hr class="divider">
  </div>
</section>
{%- endif %}
