<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
{% if noindex %}<meta name="robots" content="noindex">{% endif %}
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}/images/{{ ogImage or 'supernova-at-anchor.webp' }}">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" type="image/png" href="/favicon.png">
<link rel="preload" href="/assets/fonts/montserrat-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/source-sans-3-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
{% if hero and hero.image %}<link rel="preload" as="image" imagesrcset="{{ hero.image | heroSrcset }}" imagesizes="100vw" fetchpriority="high">{% endif %}
<style>{% inlineCss %}</style>
{% include "tracking-head.njk" %}
{% if schema %}<script type="application/ld+json">{{ schema | safe }}</script>{% endif %}
{% if breadcrumb %}<script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"{{ site.url }}/"},{"@type":"ListItem","position":2,"name":"Expeditions","item":"{{ site.url }}/expeditions/"},{"@type":"ListItem","position":3,"name":{{ hero.h1 | json | safe }},"item":"{{ site.url }}{{ page.url }}"}]}</script>{% endif %}
</head>
<body class="{{ bodyClass }}">
{% if site.gtm %}<noscript><iframe src="https://www.googletagmanager.com/ns.html?id={{ site.gtm }}" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>{% endif %}
<a class="skip" href="#main">Skip to content</a>
<header class="site-header" id="top">
  <div class="wrap header-inner">
    <a class="brand" href="/" aria-label="Supernova Expeditions">
      <img class="logo-desk" src="/images/logo-emblem-80.webp" srcset="/images/logo-emblem-80.webp 1x, /images/logo-emblem-160.webp 2x, /images/logo-emblem-240.webp 3x" alt="" width="80" height="80">
      <img class="logo-phone" src="/images/logo-full-240.webp" srcset="/images/logo-full-240.webp 1x, /images/logo-full-360.webp 2x" alt="" width="89" height="72">
      <span class="brand-text"><span>Supernova</span><small>Expeditions</small></span>
    </a>
    <a class="btn btn-book header-book" href="{{ site.bookHref }}">{{ site.bookLabel }}</a>
    <button class="menu-toggle" aria-expanded="false" aria-controls="primary-nav"><span class="sr">Menu</span><span class="bars"></span></button>
    <nav id="primary-nav" class="primary-nav" aria-label="Main">
      <ul>
      {% for item in site.nav %}
        <li class="{% if item.children %}has-sub{% endif %}">
          <a href="{{ item.href }}"{% if page.url == item.href %} aria-current="page"{% endif %}>{{ item.label }}</a>
          {% if item.children %}
          <ul class="sub">
            {% for c in item.children %}<li><a href="{{ c.href }}"{% if page.url == c.href %} aria-current="page"{% endif %}>{{ c.label }}</a></li>{% endfor %}
          </ul>
          {% endif %}
        </li>
      {% endfor %}
      </ul>
      <a class="nav-phone" href="{{ site.phoneHref }}">{{ site.phone }}</a>
    </nav>
  </div>
</header>

<main id="main">
{{ content | safe }}
</main>

<section class="newsletter-band">
  <div class="wrap newsletter-inner">
    <div>
      <p class="nl-title">Get first word on new expeditions</p>
      <p>Trip dates, open staterooms and new routes, a few times a season. No spam.</p>
    </div>
    <form class="newsletter-form" name="newsletter" method="POST" data-netlify="true" netlify-honeypot="company" action="/thanks/?f=newsletter">
      <input type="hidden" name="form-name" value="newsletter">
      <input type="hidden" name="source" value="footer">
      <p class="hp"><label>Company <input name="company"></label></p>
      <label class="sr" for="nl-email-footer">Email</label>
      <input id="nl-email-footer" type="email" name="email" placeholder="Your email" required>
      <button class="btn btn-accent" type="submit">Sign Up</button>
    </form>
  </div>
</section>

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <img src="/images/logo-full-240.webp" srcset="/images/logo-full-240.webp 1x, /images/logo-full-480.webp 2x" alt="Supernova Expeditions logo" width="180" height="146" loading="lazy" class="footer-logo">
      {% include "social.njk" %}
    </div>
    <div>
      <p class="footer-title">Expeditions</p>
      <ul>
        <li><a href="/scuba-diving-expeditions/">Scuba Diving Expeditions</a></li>
        <li><a href="/private-charters/">Private Charters</a></li>
        <li><a href="/mountain-bike-expeditions/">Mountain Bike Expeditions</a></li>
        <li><a href="/calendar/">Trip Calendar</a></li>
        <li><a href="/pricing/">Pricing</a></li>
      </ul>
    </div>
    <div>
      <p class="footer-title">Supernova</p>
      <ul>
        <li><a href="/the-boat/">The Boat</a></li>
        <li><a href="/about-us/">About Captain Paul</a></li>
        <li><a href="/gallery/">Gallery</a></li>
        <li><a href="/faq/">FAQ</a></li>
        <li><a href="/contact/">Contact</a></li>
      </ul>
    </div>
    <div>
      <p class="footer-title">Get in Touch</p>
      <p><a href="{{ site.phoneHref }}">{{ site.phone }}</a><br><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
      <p>{{ site.address.street }}<br>{{ site.address.city }}, {{ site.address.state }} {{ site.address.zip }}</p>
    </div>
  </div>
  <div class="wrap footer-bottom">
    <p>&copy; <span id="yr">2026</span> Supernova Expeditions · <a href="/privacy-policy/">Privacy Policy</a></p>
    <p>Website by <a href="https://www.saltwatermarketing.net/" target="_blank" rel="noopener">Saltwater Marketing</a></p>
  </div>
</footer>


<div class="nl-modal" id="nl-modal" role="dialog" aria-modal="true" aria-labelledby="nl-title" hidden>
  <div class="nl-card">
    <button class="nl-close" aria-label="Close">&times;</button>
    {% img "humpback-whale-tail.webp", "Humpback whale tail rising out of the Salish Sea", "460px" %}
    <div class="nl-body">
      <h2 id="nl-title">Join the Expedition List</h2>
      <p>Be the first to hear about new trip dates, open staterooms and special offers.</p>
      <form name="newsletter" method="POST" data-netlify="true" netlify-honeypot="company" action="/thanks/?f=newsletter">
        <input type="hidden" name="form-name" value="newsletter">
        <input type="hidden" name="source" value="popup">
        <p class="hp"><label>Company <input name="company"></label></p>
        <label class="sr" for="nl-email-pop">Email</label>
        <input id="nl-email-pop" type="email" name="email" placeholder="Your email" required>
        <button class="btn btn-accent" type="submit">Sign Me Up</button>
      </form>
      <button class="nl-later" type="button">No thanks</button>
    </div>
  </div>
</div>

<script src="/assets/js/site.js" defer></script>
{% if pageScript %}<script src="/assets/js/{{ pageScript }}" defer></script>{% endif %}
</body>
</html>
